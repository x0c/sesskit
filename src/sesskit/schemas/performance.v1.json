{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/x0c/sesskit/schemas/performance.v1.json",
  "title": "SessKit Performance Snapshot (sesskit.performance/v1)",
  "description": "Read-only timing/rate observations over preserved native history for one session: a bounded summary plus optional paged records. Rates are derived only from explicitly authorized native numerator/interval pairs; missing stays missing and invalid never becomes zero speed. Never native message content, paths, credentials or raw payloads.",
  "type": "object",
  "required": ["schema", "runtime", "state", "history_view", "watermark", "entries_read", "summary"],
  "properties": {
    "schema": {
      "const": "sesskit.performance/v1",
      "description": "Dataset version; the CLI envelope version is separate"
    },
    "session_ref": { "type": ["string", "null"] },
    "runtime": { "type": "string" },
    "state": {
      "type": "string",
      "enum": ["available", "empty", "unavailable", "unsupported"]
    },
    "history_view": { "type": "string", "enum": ["all_branches", "active_branch"] },
    "watermark": {
      "type": "boolean",
      "description": "Whether a source watermark was captured (never the path)"
    },
    "entries_read": { "type": "integer", "minimum": 0 },
    "summary": { "$ref": "#/$defs/performanceSummary" },
    "selectors": {
      "type": "object",
      "properties": {
        "turn_id": { "type": "string" },
        "message_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "matched_records": { "type": "integer", "minimum": 0 },
    "unmatched_records": { "type": "integer", "minimum": 0 },
    "unlinked_records": { "type": "integer", "minimum": 0 },
    "diagnostics": { "type": "array", "items": { "type": "string" } },
    "capabilities": {
      "$ref": "#/$defs/performanceCapabilities",
      "description": "Optional capability advertisement; the performance command payload omits it"
    },
    "detail": { "$ref": "#/$defs/performanceDetail" }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["origin"],
      "properties": {
        "origin": { "type": "string", "enum": ["native", "inferred", "unknown"] },
        "field": { "type": ["string", "null"] },
        "record": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "performanceRecord": {
      "type": "object",
      "required": ["performance_id", "runtime", "record", "scope_kind", "kind", "output_semantics", "rate_basis", "clock", "evidence", "diagnostics"],
      "properties": {
        "performance_id": { "type": "string" },
        "runtime": { "type": "string" },
        "record": {
          "type": "string",
          "description": "Safe native locator (line/row/position), never content or a path"
        },
        "scope_kind": { "type": "string" },
        "scope_id": { "type": ["string", "null"] },
        "kind": {
          "type": "string",
          "enum": ["response_elapsed", "provider_phase_elapsed", "step_elapsed", "stream_elapsed", "turn_elapsed", "first_output_latency", "first_part_latency", "request_to_reply_elapsed", "thinking_elapsed", "session_elapsed", "session_api_elapsed", "session_api_without_retries_elapsed", "session_tool_elapsed", "native_duration"]
        },
        "duration_ms": {
          "type": ["number", "null"],
          "description": "Compatible positive native interval in milliseconds; finite when present"
        },
        "output_tokens": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "output_semantics": {
          "type": "string",
          "enum": ["inclusive_output", "visible_output", "provider_output", "unknown"]
        },
        "tokens_per_second": {
          "type": ["number", "null"],
          "description": "Derived only with explicit authorization; finite when present, never zero-filled"
        },
        "rate_basis": {
          "type": "string",
          "enum": ["derived", "unavailable"]
        },
        "clock": {
          "type": "string",
          "enum": ["monotonic", "wall", "mixed", "unknown"]
        },
        "started_at": {
          "type": ["number", "null"],
          "description": "UTC epoch seconds, only when actually known"
        },
        "ended_at": {
          "type": ["number", "null"],
          "description": "UTC epoch seconds, only when actually known"
        },
        "message_id": { "type": ["string", "null"] },
        "turn_id": { "type": ["string", "null"] },
        "response_id": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "provider": { "type": ["string", "null"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "diagnostics": { "type": "array", "items": { "type": "string" } }
      }
    },
    "performanceSummary": {
      "type": "object",
      "required": ["coverage", "record_count", "rate_count", "observed_operations", "kinds", "latest"],
      "properties": {
        "coverage": {
          "type": "string",
          "enum": ["partial", "unknown", "not_recorded", "unsupported"]
        },
        "record_count": { "type": "integer", "minimum": 0 },
        "rate_count": { "type": "integer", "minimum": 0 },
        "observed_operations": { "type": "integer", "minimum": 0 },
        "kinds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Bounded named interval kinds present, in first-seen order"
        },
        "latest": {
          "type": ["object", "null"],
          "description": "Last source-order record serialized, or null; never an average"
        }
      }
    },
    "performanceCapabilities": {
      "type": "object",
      "required": ["runtime", "supported", "timing_kinds", "rate_kinds", "history_views", "provider_decode_timing", "incremental_support"],
      "properties": {
        "runtime": { "type": "string" },
        "supported": { "type": "boolean" },
        "timing_kinds": { "type": "array", "items": { "type": "string" } },
        "rate_kinds": { "type": "array", "items": { "type": "string" } },
        "history_views": { "type": "array", "items": { "type": "string" } },
        "provider_decode_timing": { "type": "boolean" },
        "incremental_support": { "type": "boolean" }
      }
    },
    "performanceDetail": {
      "type": "object",
      "required": ["kind", "items", "returned", "total", "has_more"],
      "properties": {
        "kind": { "type": "string", "enum": ["records"] },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/performanceRecord" }
        },
        "returned": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "has_more": { "type": "boolean" },
        "cursor": { "type": ["string", "null"] },
        "read_coverage": { "type": "object" },
        "scope": { "type": "object" }
      }
    }
  }
}
